# --- DigitalOcean Serverless Inference (required) ---
# Create a Model Access Key: DO Control Panel -> INFERENCE -> Manage -> Model Access Keys
# The server REFUSES to start if this is empty, too short (<20 chars), or looks
# like a placeholder (contains "fake", "test", "dummy", "changeme", etc.).
DO_INFERENCE_BASE_URL=https://inference.do-ai.run/v1
DO_INFERENCE_API_KEY=

# Local dev bypass: set to 1 to allow the server to boot without a real DO key.
# Real requests to DO will 401, but you can poke the UI / /docs / DB.
# NEVER set this in production.
SHADOW_PROXY_ALLOW_DUMMY_KEY=0

# --- Proxy auth (comma-separated bearer tokens accepted by /v1/chat) ---
# Leave blank in local dev to disable auth. NEVER leave blank in production.
PROXY_API_KEYS=

# --- Storage ---
# Dev default: local SQLite file. Prod: postgresql+asyncpg://user:pass@host:5432/db
DATABASE_URL=sqlite+aiosqlite:///./data/comparisons.db

# --- Raw payload store (DO Spaces / S3-compatible). Optional in dev. ---
RAW_STORE_TYPE=filesystem
RAW_STORE_FILESYSTEM_PATH=./data/raw
DO_SPACES_BUCKET=
DO_SPACES_REGION=nyc3
DO_SPACES_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
DO_SPACES_KEY=
DO_SPACES_SECRET=

# --- Observability ---
LOG_LEVEL=INFO
LOG_FORMAT=json          # json | console

# --- Config file location ---
CONFIG_FILE=./config/models.yaml
